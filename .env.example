# Copia este archivo como .env para desarrollo local. En Render se configuran en "Environment".

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública final (se usa en Facebook/WhatsApp y en las etiquetas Open Graph)
PUBLIC_URL=https://supermass-abarrotes.onrender.com

# --- Base de datos PostgreSQL (Render o Supabase) ---
# Si se deja vacía, se usa una base en memoria SOLO para pruebas.
DATABASE_URL=postgres://usuario:contraseña@host:5432/supermass
# auto | true | false  (auto activa SSL para hosts externos como Supabase)
DB_SSL=auto

# --- Administrador ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña-larga
# Cadena larga y aleatoria para firmar la sesión (ej. openssl rand -hex 32)
SESSION_SECRET=
ADMIN_HORAS_SESION=12

# --- Datos de la rifa ---
RIFA_NOMBRE=Gran Rifa Navideña SuperMass
RIFA_PREMIO=Una despensa de $5,000
RIFA_FECHA=Sábado 19 de diciembre de 2026
# Pon false para cerrar el registro
REGISTRO_ABIERTO=true

# --- Tienda ---
TIENDA_DIRECCION=Av. Principal #123, Col. Centro, C.P. 00000
TIENDA_RESPONSABLE=SuperMass Abarrotes
TIENDA_CORREO=
FACEBOOK_URL=https://www.facebook.com/1291426010723582
# Publicaciones de Facebook en la web (token de PÁGINA permanente; nunca lo subas a git)
FACEBOOK_PAGE_ID=1291426010723582
FACEBOOK_PAGE_TOKEN=
# WhatsApp de la tienda a 10 dígitos (recibe los pedidos). Vacío = sin botón de WhatsApp.
TIENDA_WHATSAPP=
TIENDA_HORARIO=Lunes a domingo de 7:00 a 22:00
TIENDA_ZONA_ENVIO=Colonias cercanas a la tienda

# --- Antispam ---
LIMITE_IP_MINUTO=5
LIMITE_POR_TELEFONO=10
LIMITE_TELEFONO_MINUTO=2
LIMITE_FOTO_MB=10

# Opcional: imagen Open Graph propia (1200x630). Si no, se genera en /og.png
OG_IMAGE_URL=
